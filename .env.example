# Server
PORT=3000
# Optional: comma-separated public hostnames if your platform does not set RENDER_EXTERNAL_HOSTNAME.
MCP_ALLOWED_HOSTS=

# Optional: set this if you want Poke to authenticate to your MCP server.
# Add the same value in Poke's "API Key" field when creating the custom integration.
POKE_INTEGRATION_API_KEY=

# Create an app at https://developer.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/oauth/callback

# Get these with:
# npm run oauth:url
# npm run oauth:token -- --code CODE_FROM_REDIRECT
WHOOP_ACCESS_TOKEN=
WHOOP_REFRESH_TOKEN=
